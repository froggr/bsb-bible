<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Reading aloud has to survive the screen going off: that needs a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_agenda"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Handle rotation ourselves. The layout is Compose and already reflows to any
             size, so there is nothing to rebuild - but the default behaviour destroys and
             recreates the activity, which built a fresh Narrator and Bed and so restarted
             the music and killed the reading every time the phone turned. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open at a passage: bsb://open?ref=John+3:16 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bsb" />
            </intent-filter>
            <!-- The places a verse-of-the-day widget already links to. Not verified app
                 links (no domain of ours), so Android offers this app alongside the browser
                 and remembers the choice. -->
            <!-- One filter per site: within a filter every path pattern applies to every
                 host, so BibleHub (whose book is in the path) cannot share a filter with
                 the two that have a fixed prefix. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.biblegateway.com" android:pathPrefix="/passage" />
                <data android:scheme="https" android:host="biblegateway.com" android:pathPrefix="/passage" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.bible.com" android:pathPrefix="/bible/" />
                <data android:scheme="https" android:host="bible.com" android:pathPrefix="/bible/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="biblehub.com" />
                <data android:scheme="https" android:host="www.biblehub.com" />
            </intent-filter>
        </activity>
        <!-- The measuring harness, kept reachable but off the launcher. -->
        <activity
            android:name=".BenchActivity"
            android:exported="true"
            android:label="BSB diagnostics" />
        <service
            android:name=".ReadingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
    </application>
</manifest>
